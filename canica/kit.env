# The Canica kit the console installs next. Changing this file on main publishes it:
# .github/workflows/canica-kit.yml checks the download against every value below, proves that
# the published kit upgrades to it, signs its manifest and publishes release
# canica-<firmware slug>. SERIAL only grows: consoles refuse an older one.
VERSION=1.0.1-rc41.2
LABEL=RC41.2
SERIAL=2026112508
# One line the console shows after installing it (optional, at most 66 characters). The update
# screen fits 46 a line, and kits up to RC37 break it every 56: each piece must fit.
NOTE='Novedades: salir con el atajo ya no da error.'
MODEL='Anbernic RG35XX-H'
FIRMWARE='scarab 2026/05/11 00:09'
URL=https://github.com/eduarbo/canica/releases/download/v1.0.1-rc41.2/canica-1.0.1-rc41.2-instalador.sh
SIZE=5574777
SHA256=cea910d957caa95a660d430d16c635ca104ba888bcbad1e2a10354ec7e11ce39
KIT=canica-1.0.1-rc41.2-rg35xx-h.zip
KIT_SHA256=a25bd693782f7204eee81a74e5ec04b6ab923f725e4e0913940d7deca0d298ec
