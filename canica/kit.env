# The Canica kit the console installs next. Changing this file on main publishes it:
# .github/workflows/canica-kit.yml checks the download against every value below, proves that
# the published kit upgrades to it, signs its manifest and publishes release
# canica-<firmware slug>. SERIAL only grows: consoles refuse an older one.
VERSION=1.0.1-rc42
LABEL=RC42
SERIAL=2026112510
# One line the console shows after installing it (optional, at most 66 characters). The update
# screen fits 46 a line, and kits up to RC37 break it every 56: each piece must fit.
# NOTE_EN is the same line in English for consoles in any other language (optional, at most
# 66 characters; kits from RC42 show it, none without it).
NOTE='Novedades: Canica también habla inglés.'
NOTE_EN='New: Canica now speaks English too.'
MODEL='Anbernic RG35XX-H'
FIRMWARE='scarab 2026/05/11 00:09'
URL=https://github.com/eduarbo/canica/releases/download/v1.0.1-rc42/canica-1.0.1-rc42-instalador.sh
SIZE=5609708
SHA256=62b77ecbc23140cb8c3d6c0d2b37dada94b4c0fa771f0dd307c87e174f09497f
KIT=canica-1.0.1-rc42-rg35xx-h.zip
KIT_SHA256=6f1f741e220170c3ba50948c55fa4dde8b62f2d0c8625c6b4b80fc20d3c309d1
INVENTORY_SHA256=3a528f635d38af3a47f07fea60efc34f87202e9180cb8d5908b0e46af51a1bda
