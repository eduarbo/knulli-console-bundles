From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:37:41 +0000
Subject: [PATCH] Let a theme give a video the picture it replaces

- A video element takes "snapshot", a picture path that may be bound (a
  game's capture): shown until the video plays and when there is none,
  with the video's colour and saturation, as the snapshot a game list
  gives its video. Once the video plays it replaces the picture whatever
  their sizes, where a separate image under the video stayed visible
  around a video of another shape.
---
 es-core/src/ThemeData.cpp                 |  1 +
 es-core/src/components/VideoComponent.cpp | 23 +++++++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/es-core/src/ThemeData.cpp b/es-core/src/ThemeData.cpp
index f95cbce4..b0c36dd9 100644
--- a/es-core/src/ThemeData.cpp
+++ b/es-core/src/ThemeData.cpp
@@ -576,6 +576,7 @@ std::map<std::string, std::map<std::string, ThemeData::ElementPropertyType>> The
 		{ "color", COLOR },
 		{ "snapshotSource", STRING },			// image, thumbnail, marquee
 		{ "defaultSnapshot", PATH },
+		{ "snapshot", PATH },					// the picture shown until the video plays (a bound capture)
 		{ "loops", FLOAT },						// Number of loops to do -1 (default) is infinite 
 		{ "audio", BOOLEAN },
 		{ "linearSmooth", BOOLEAN },
diff --git a/es-core/src/components/VideoComponent.cpp b/es-core/src/components/VideoComponent.cpp
index 2c15ba88..5870baf6 100644
--- a/es-core/src/components/VideoComponent.cpp
+++ b/es-core/src/components/VideoComponent.cpp
@@ -379,6 +379,20 @@ void VideoComponent::applyTheme(const std::shared_ptr<ThemeData>& theme, const s
 	if (elem->has("defaultSnapshot"))
 		mStaticImage.setDefaultImage(elem->get<std::string>("defaultSnapshot"));
 
+	// The theme's snapshot (a capture, usually bound to the game): shown until the video plays, and in its
+	// place when there is none, with the video's colour and saturation; once the video plays it replaces it
+	if (elem->has("snapshot"))
+	{
+		if (!elem->has("snapshot_binding"))
+			setImage(elem->get<std::string>("snapshot"));
+
+		if (elem->has("color"))
+			mStaticImage.setColorShift(elem->get<unsigned int>("color"));
+
+		if (elem->has("saturation"))
+			mStaticImage.setSaturation(Math::clamp(elem->get<float>("saturation"), 0.0f, 1.0f));
+	}
+
 	mStaticImage.applyStoryboard(elem, "snapshot");
 }
 
@@ -619,6 +633,9 @@ ThemeData::ThemeElement::Property VideoComponent::getProperty(const std::string
 	if (name == "path")
 		return mVideoPath;
 
+	if (name == "snapshot")
+		return mStaticImagePath;
+
 	if (name == "enabled")
 		return mEnabled;
 
@@ -642,6 +659,12 @@ void VideoComponent::setProperty(const std::string name, const ThemeData::ThemeE
 
 		mThemedPath = mVideoPath;
 	}
+	else if (value.type == ThemeData::ThemeElement::Property::PropertyType::String && name == "snapshot")
+	{
+		// The same picture bound again (the cursor moved, the game stayed) keeps the video as it plays
+		if (value.s != mStaticImagePath)
+			setImage(value.s);
+	}
 	else if (value.type == ThemeData::ThemeElement::Property::PropertyType::Bool && name == "enabled")
 	{
 		mEnabled = value.b;
