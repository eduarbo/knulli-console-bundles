diff --git a/es-core/src/SystemConf.cpp b/es-core/src/SystemConf.cpp
index 64bb9cb2..67daa4d3 100644
--- a/es-core/src/SystemConf.cpp
+++ b/es-core/src/SystemConf.cpp
@@ -14,6 +14,41 @@
 #include <iostream>
 #include <SDL_timer.h>
 
+#if defined(KNULLI) && !defined(WIN32)
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+// knulli-settings-set rewrites knulli.conf while holding this lock. Holding it from
+// reading the file to replacing it keeps either writer from dropping the other's change.
+class ConfLock
+{
+public:
+	ConfLock() : mFd(open("/var/run/knulli-settings-set.lock", O_RDWR | O_CREAT | O_CLOEXEC, 0644))
+	{
+		// Wait up to 2 s, then save anyway rather than lose the change
+		for (int i = 0; mFd >= 0 && i < 200; i++)
+		{
+			if (flock(mFd, LOCK_EX | LOCK_NB) == 0)
+				return;
+
+			usleep(10000);
+		}
+
+		LOG(LogWarning) << "saveSystemConf : knulli.conf lock not available, saving without it";
+	}
+
+	~ConfLock()
+	{
+		if (mFd >= 0)
+			close(mFd); // releases the lock
+	}
+
+private:
+	int mFd;
+};
+#endif
+
 static std::string mapSettingsName(const std::string& name)
 {
 	if (name == "system.language")
@@ -108,6 +143,10 @@ bool SystemConf::saveSystemConf()
 	if (changedConf.empty())
 		return false;
 
+#if defined(KNULLI) && !defined(WIN32)
+	ConfLock lock;
+#endif
+
 	std::ifstream filein(mSystemConfFile); //File to read from
 
 #ifndef WIN32
@@ -185,25 +224,20 @@ bool SystemConf::saveSystemConf()
 
 	LOG(LogDebug) << "saveSystemConf :  " << lastTime;
 
-	std::ofstream fileout(mSystemConfFileTmp); //Temporary file
-	if (!fileout)
-	{
-		LOG(LogError) << "Unable to open for saving :  " << mSystemConfFileTmp << "\n";
-		return false;
-	}
+	std::string content;
 	for (int i = 0; i < fileLines.size(); i++) 
 	{
 		if (fileLines[i] != removeID)
-			fileout << fileLines[i] << "\n";
+			content += fileLines[i] + "\n";
 	}
 
-	fileout.close();
-	
-	std::ifstream  src(mSystemConfFileTmp, std::ios::binary);
-	std::ofstream  dst(mSystemConfFile, std::ios::binary);
-	dst << src.rdbuf();
+	// Never truncate knulli.conf in place: a power cut would leave it empty or partial
+	if (!Utils::FileSystem::writeFileAtomic(mSystemConfFile, content))
+	{
+		LOG(LogError) << "Unable to save :  " << mSystemConfFile << "\n";
+		return false;
+	}
 
-	remove(mSystemConfFileTmp.c_str());
 	changedConf.clear();
 
 	Scripting::fireEvent("config-changed");
diff --git a/es-core/src/utils/FileSystemUtil.cpp b/es-core/src/utils/FileSystemUtil.cpp
index 868c1d43..8de6a10c 100644
--- a/es-core/src/utils/FileSystemUtil.cpp
+++ b/es-core/src/utils/FileSystemUtil.cpp
@@ -28,6 +28,10 @@
 #include <dirent.h>
 #include <unistd.h>
 #include <mutex>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
 #endif // _WIN32
 
 #include <fstream>
@@ -1278,6 +1282,93 @@ namespace Utils
 			fclose(file);
 		}
 
+		bool writeFileAtomic(const std::string& fileName, const std::string& text)
+		{
+#if defined(_WIN32)
+			std::string tmp = fileName + ".tmp";
+			FILE* file = _wfopen(Utils::String::convertToWideString(tmp).c_str(), L"wb");
+			if (file == nullptr)
+				return false;
+
+			bool written = fwrite(text.data(), 1, text.size(), file) == text.size();
+			written = (fflush(file) == 0) && written;
+			fclose(file);
+
+			if (!written || !MoveFileExW(Utils::String::convertToWideString(tmp).c_str(), Utils::String::convertToWideString(fileName).c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+			{
+				_wremove(Utils::String::convertToWideString(tmp).c_str());
+				return false;
+			}
+
+			return true;
+#else
+			// Replace the file a symlink points to, not the symlink
+			std::string target = fileName;
+			char resolved[PATH_MAX];
+			if (realpath(fileName.c_str(), resolved) != nullptr)
+				target = resolved;
+
+			std::vector<char> tmp(target.begin(), target.end());
+			for (char c : std::string(".tmp.XXXXXX"))
+				tmp.push_back(c);
+			tmp.push_back(0);
+
+			int fd = mkstemp(tmp.data());
+			if (fd < 0)
+				return false;
+
+			// mkstemp creates 0600: keep the mode and owner of the file being replaced
+			struct stat info;
+			if (stat(target.c_str(), &info) == 0)
+			{
+				fchmod(fd, info.st_mode & 07777);
+
+				// Best effort: only root can give the file another owner
+				int owned = fchown(fd, info.st_uid, info.st_gid);
+				(void)owned;
+			}
+			else
+				fchmod(fd, 0644);
+
+			bool written = true;
+			const char* data = text.data();
+			size_t left = text.size();
+			while (left > 0)
+			{
+				ssize_t count = write(fd, data, left);
+				if (count < 0 && errno == EINTR)
+					continue;
+
+				if (count <= 0)
+				{
+					written = false;
+					break;
+				}
+
+				data += count;
+				left -= count;
+			}
+
+			written = (fsync(fd) == 0) && written;
+			written = (close(fd) == 0) && written;
+
+			if (!written || rename(tmp.data(), target.c_str()) != 0)
+			{
+				unlink(tmp.data());
+				return false;
+			}
+
+			int dir = open(getParent(target).c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+			if (dir >= 0)
+			{
+				fsync(dir);
+				close(dir);
+			}
+
+			return true;
+#endif
+		}
+
 		bool renameFile(const std::string src, const std::string dst, bool overWrite)
 		{
 			std::string path = getGenericPath(src);
