From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 03:21:40 +0000
Subject: [PATCH] Bind save state support by the game's own emulator and core

- {game:saveStatesSupported} was true when any emulator of the game's
  system keeps save states, folders included. It now follows the emulator
  and core the game is set to run with (the core too where the states are
  kept per core), and is false on a folder.
---
 es-app/src/FileData.cpp            |  5 +++--
 es-app/src/SaveStateRepository.cpp | 19 +++++++++++++++++++
 es-app/src/SaveStateRepository.h   |  3 +++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/es-app/src/FileData.cpp b/es-app/src/FileData.cpp
index 960f1e40..aba7211d 100644
--- a/es-app/src/FileData.cpp
+++ b/es-app/src/FileData.cpp
@@ -1989,9 +1989,10 @@ BindableProperty FileData::getProperty(const std::string& name)
 		return Utils::FileSystem::exists(getMetadata(MetaDataId::Manual)) || Utils::FileSystem::exists(getMetadata(MetaDataId::Magazine)); // ? _("YES") : _("NO");
 	}
 
-	// Whether the game's emulator keeps save states (what the game list's X opens), whether it has one or not
+	// Whether the game's own emulator and core keep save states (what the game list's X opens), whether it has
+	// one or not; false on a folder
 	if (name == "saveStatesSupported")
-		return SaveStateRepository::isEnabled(this);
+		return SaveStateRepository::isEnabledForGame(this);
 
 	if (name == "hasSaveState" || name == "hassavestate" || name == "savestate")
 	{
diff --git a/es-app/src/SaveStateRepository.cpp b/es-app/src/SaveStateRepository.cpp
index 28f43c9b..fd2e23d6 100644
--- a/es-app/src/SaveStateRepository.cpp
+++ b/es-app/src/SaveStateRepository.cpp
@@ -199,6 +199,25 @@ bool SaveStateRepository::isEnabled(FileData* game)
 	return SaveStateConfigFile::getSaveStateConfigs(system).size() != 0;
 }
 
+bool SaveStateRepository::isEnabledForGame(FileData* game)
+{
+	if (game == nullptr || game->getType() != GAME || !isEnabled(game))
+		return false;
+
+	// Without the configuration file one default configuration serves every emulator
+	if (!SaveStateConfigFile::isEnabled())
+		return true;
+
+	std::string emulator = game->getEmulator();
+	std::string core = game->getCore();
+
+	for (auto conf : SaveStateConfigFile::getSaveStateConfigs(game->getSourceFileData()->getSystem()))
+		if (conf->emulator == emulator && (conf->core.empty() || conf->core == core))
+			return true;
+
+	return false;
+}
+
 int SaveStateRepository::getNextFreeSlot(FileData* game, std::shared_ptr<SaveStateConfig> config)
 {
 	if (!isEnabled(game))
diff --git a/es-app/src/SaveStateRepository.h b/es-app/src/SaveStateRepository.h
index 43e264fa..ea9da3b0 100644
--- a/es-app/src/SaveStateRepository.h
+++ b/es-app/src/SaveStateRepository.h
@@ -17,6 +17,9 @@ public:
 	~SaveStateRepository();
 
 	static bool isEnabled(FileData* game);
+	// The game's own emulator and core keep save states: a game (not a folder) whose configured emulator, and
+	// core where the states are kept per core, has a save state configuration
+	static bool isEnabledForGame(FileData* game);
 	static int	getNextFreeSlot(FileData* game, std::shared_ptr<SaveStateConfig> config);
 	static void renumberSlots(FileData* game, std::shared_ptr<SaveStateConfig> config);
 
