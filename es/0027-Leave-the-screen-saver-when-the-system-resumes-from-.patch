@@ -33,7 +34,7 @@
 #endif
 
 Window::Window() : mNormalizeNextUpdate(false), mFrameTimeElapsed(0), mFrameCountElapsed(0), mFrameDrawnStart(0), mAverageDeltaTime(10),
-  mAllowSleep(true), mSleeping(false), mTimeSinceLastInput(0), mIdleVideo(false), mIdleSlides(false), mScreenSaver(NULL), mRenderScreenSaver(false), mClockElapsed(0), mMouseCapture(nullptr), mMenuBackgroundShaderTextureCache(-1)
+  mAllowSleep(true), mSleeping(false), mTimeSinceLastInput(0), mIdleVideo(false), mIdleSlides(false), mSuspendedMs(-1), mScreenSaver(NULL), mRenderScreenSaver(false), mClockElapsed(0), mMouseCapture(nullptr), mMenuBackgroundShaderTextureCache(-1)
 {			
 	mTransitionOffset = 0;
 
@@ -932,6 +933,27 @@ void Window::render()
 	}
 }
 
+void Window::checkSystemResume()
+{
+#ifndef WIN32
+	struct timespec boot, mono;
+	if (clock_gettime(CLOCK_BOOTTIME, &boot) != 0 || clock_gettime(CLOCK_MONOTONIC, &mono) != 0)
+		return;
+
+	long long suspended = ((long long)boot.tv_sec - mono.tv_sec) * 1000 + (boot.tv_nsec - mono.tv_nsec) / 1000000;
+	bool resumed = mSuspendedMs >= 0 && suspended - mSuspendedMs > 1000;
+	mSuspendedMs = suspended;
+
+	if (!resumed)
+		return;
+
+	LOG(LogInfo) << "Window: back from a system suspend; the screen saver stops";
+	cancelScreenSaver();
+	updateIdlePause();
+	Renderer::invalidateFrame();
+#endif
+}
+
 bool Window::drawsOnlyChanges()
 {
 	return mGuiStack.size() == 1 && !mRenderScreenSaver && !mSleeping && Settings::getInstance()->getBool("RenderOnChange");
diff --git a/es-core/src/Window.h b/es-core/src/Window.h
index 5ae98814..7c5aef20 100644
--- a/es-core/src/Window.h
+++ b/es-core/src/Window.h
@@ -97,6 +97,11 @@ public:
 	bool cancelScreenSaver();
 	void renderScreenSaver();
 
+	// Back from a system suspend (the time asleep counts in CLOCK_BOOTTIME, not in CLOCK_MONOTONIC or SDL's
+	// ticks): the screen saver stops and the idle times start over, as on a key, so the view shows at once
+	// (the key that woke the system never reaches ES). Called on every turn of the main loop.
+	void checkSystemResume();
+
 	void postToUiThread(const std::function<void()>& func, void* data = nullptr);
 	void unregisterPostedFunctions(void* data);
 	void reactivateGui();
@@ -183,6 +188,7 @@ private:
 	unsigned int mTimeSinceLastInput;
 	bool mIdleVideo;
 	bool mIdleSlides;
+	long long mSuspendedMs;	// CLOCK_BOOTTIME less CLOCK_MONOTONIC at the last check; -1 before the first
 	void updateIdlePause();
 
 	bool mRenderedHelpPrompts;
