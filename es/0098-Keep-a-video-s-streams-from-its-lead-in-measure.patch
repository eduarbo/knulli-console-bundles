-			return 0;
+			return;
 
 		std::vector<std::pair<int, int>> frames;
 		char buffer[1024];
 		while (fgets(buffer, sizeof(buffer), pipe) != nullptr)
 		{
+			// the file's streams, listed before the frames ("Stream #0:0...: Video: h264 ..., 320x240 [SAR...")
+			const char* stream = strstr(buffer, "Stream #0:");
