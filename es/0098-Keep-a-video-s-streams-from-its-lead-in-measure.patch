 es-core/src/components/VideoLeadIn.h         |  7 ++-
 es-core/src/components/VideoLight.h          | 27 ++++++++
 es-core/src/components/VideoVlcComponent.cpp | 15 ++++-
 4 files changed, 101 insertions(+), 14 deletions(-)

