+	if (mColumnSlide.to > 0.5f)
+	{
+		home->setColumnFade(leaving);
+		mColumnSlide.list->setColumnFade(coming);
+	}
+	else
+	{
+		mColumnSlide.list->setColumnFade(leaving);
+		home->setColumnFade(coming);
+	}
+}
