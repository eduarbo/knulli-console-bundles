@@ -91,11 +104,22 @@ namespace
 
 			Known known;
 			known.stamp = line.substr(a + 1, b - a - 1);
-			int audio = 0;
-			if (sscanf(line.substr(0, a).c_str(), "%d %u %u %d", &known.ms, &known.width, &known.height, &audio) < 4)
-				known.width = known.height = 0;
