@@ -108,26 +132,71 @@ namespace
 	}
 
 
-	std::string quoted(const std::string& s)
+	// Bound the lifetime of the local probe. Its anonymous log is removed on close.
+	bool measure(const std::string& path, Known& known)
 	{
-		return "'" + Utils::String::replace(s, "'", "'\\''") + "'";
-	}
-
-	// The lead-in of a file from ffmpeg's showinfo of its first frames (each frame's time and luma), at low
-	// priority, with its first video stream's size and whether it has sound; 0 when ffmpeg reads no frame
-	void measure(const std::string& path, Known& known)
-	{
-		std::string command = std::string("nice -n 10 ") + FFMPEG + " -hide_banner -nostdin -v info -threads 1 -an -sn -dn -t " +
-			std::to_string(VideoLight::VIDEO_LEAD_IN_MEASURED_MS / 1000.0f) + " -i " + quoted(path) + " -vf scale=32:24,showinfo -f null - 2>&1";
-
-		known.ms = 0;
-		FILE* pipe = popen(command.c_str(), "r");
-		if (pipe == nullptr)
-			return;
-
+#ifdef _WIN32
+		return false;
+#else
+		struct stat info;
+		if (path.empty() || path[0] != '/' || stat(path.c_str(), &info) != 0 || !S_ISREG(info.st_mode))
+			return false;
+		FILE* output = tmpfile();
+		if (!output)
+			return false;
+		std::string duration = std::to_string(VideoLight::VIDEO_LEAD_IN_MEASURED_MS / 1000.0f);
+		const char* args[] = { FFMPEG, "-hide_banner", "-nostdin", "-v", "info", "-threads", "1",
+			"-an", "-sn", "-dn", "-t", duration.c_str(), "-protocol_whitelist", "file",
+			"-i", path.c_str(), "-vf", "scale=32:24,showinfo", "-f", "null", "-", nullptr };
+		posix_spawn_file_actions_t actions;
+		if (posix_spawn_file_actions_init(&actions) != 0)
+		{
+			fclose(output);
+			return false;
+		}
+		pid_t child;
+		int err = posix_spawn_file_actions_adddup2(&actions, fileno(output), STDERR_FILENO);
+		if (!err)
+			err = posix_spawn(&child, FFMPEG, &actions, nullptr, const_cast<char* const*>(args), environ);
+		posix_spawn_file_actions_destroy(&actions);
+		if (err)
+		{
+			fclose(output);
+			return false;
+		}
+		setpriority(PRIO_PROCESS, child, 10);
+		auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+		int status = 0;
+		for (;;)
+		{
+			pid_t result = waitpid(child, &status, WNOHANG);
+			if (result == child)
+				break;
+			if (result < 0 && errno != EINTR)
+			{
+				fclose(output);
+				return false;
+			}
+			std::unique_lock<std::mutex> lock(sLock);
+			if (sWake.wait_for(lock, std::chrono::milliseconds(20), [] { return sPaused; }) ||
+				std::chrono::steady_clock::now() >= deadline)
+			{
+				lock.unlock();
+				kill(child, SIGKILL);
+				while (waitpid(child, &status, 0) < 0 && errno == EINTR) { }
+				fclose(output);
+				return false;
+			}
+		}
+		if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+		{
+			fclose(output);
+			return false;
+		}
+		rewind(output);
 		std::vector<std::pair<int, int>> frames;
 		char buffer[1024];
-		while (fgets(buffer, sizeof(buffer), pipe) != nullptr)
