From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:18:56 +0000
Subject: [PATCH] Resume the global last game with a foreground hotkey and A
 chord

---
 es-app/src/views/ViewController.cpp | 18 ++++++++++++++++++
 es-core/src/InputConfig.cpp         | 23 +++++++++++++++++++++++
 es-core/src/InputConfig.h           |  9 +++++++++
 es-core/src/InputManager.cpp        |  9 +++++++++
 es-core/src/InputManager.h          |  1 +
 es-core/src/Window.cpp              |  4 +++-
 6 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/es-app/src/views/ViewController.cpp b/es-app/src/views/ViewController.cpp
index a124a639..6546d31d 100644
--- a/es-app/src/views/ViewController.cpp
+++ b/es-app/src/views/ViewController.cpp
@@ -1059,6 +1059,24 @@ bool ViewController::input(InputConfig* config, Input input)
 	    Settings::getInstance()->saveFile();
 	  }
 
+	// Claim A before the browser opens the focused card. Modal dialogs and games own their own input.
+	if (input.value && config->hotkeyHeld() && config->isMappedTo("a", input) && !config->isMappedTo("hotkey", input)
+		&& (mState.viewing == SYSTEM_SELECT || mState.viewing == GAME_LIST) && mState.system)
+	{
+		auto theme = mState.system->getTheme();
+		auto marker = theme ? theme->getVariable("esResumeChordMarker") : std::string();
+		if (!marker.empty() && Utils::FileSystem::isRegularFile(marker) && SystemConf::getInstance()->get("system.quickresume") != "0")
+		{
+			config->consumeHotkeyConfirm();
+			auto game = SystemData::getConsoleLastPlayedGame();
+			if (game)
+				launch(game);
+			else
+				mWindow->displayNotificationMessage(_("NO RECENT GAMES"));
+			return true;
+		}
+	}
+
 	// open menu
 	if(config->isMappedTo("start", input) && input.value != 0)
 	{
diff --git a/es-core/src/InputConfig.cpp b/es-core/src/InputConfig.cpp
index 0b2c80fe..510100a8 100644
--- a/es-core/src/InputConfig.cpp
+++ b/es-core/src/InputConfig.cpp
@@ -224,6 +224,29 @@ bool InputConfig::isMappedTo(const std::string& name, Input input, bool reversed
 	return false;
 }
 
+bool InputConfig::updateHotkey(Input input)
+{
+	if (input.type != TYPE_BUTTON && input.type != TYPE_KEY)
+		return false;
+	if (isMappedTo("hotkey", input))
+	{
+		mHotkeyHeld = input.value != 0;
+		if (!mHotkeyHeld)
+			mChordSpent = false;
+		return false;
+	}
+	if (!isMappedTo("a", input))
+		return false;
+	if (!input.value)
+	{
+		bool consumed = mSuppressConfirmUp;
+		mSuppressConfirmUp = false;
+		return consumed;
+	}
+	mSuppressConfirmUp = mHotkeyHeld && mChordSpent;
+	return mSuppressConfirmUp;
+}
+
 bool InputConfig::isMappedLike(const std::string& name, Input input)
 {
 	if (name == "left")
