 es-core/src/ThemeData.cpp                |  1 +
 es-core/src/components/TextComponent.cpp | 58 ++++++++++++++++++++++--
 es-core/src/components/TextComponent.h   |  6 +++
 4 files changed, 63 insertions(+), 4 deletions(-)

