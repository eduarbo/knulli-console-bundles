Date: Thu, 19 Nov 2026 15:00:52 +0000
Subject: [PATCH] Stop a video its view shows off the screen

A home with columns shows level 1 with the system's column panned off
the screen, and its last played game's video went on playing there:
heard, not seen, at level 1 and on every tab changed with L1/R1. A
video can now be marked out of view: it stops as when its view is
hidden, sound and all, and leaves its snapshot in its place while it
is still drawn (the pan). The system view marks its extras' videos out
of view at level 1 and back in view at level 2. "VideoCheck" also logs
each video that starts or stops, with the count playing.
---
 es-app/src/views/SystemView.cpp              | 25 ++++++++++++++++++++
 es-app/src/views/SystemView.h                |  2 ++
 es-core/src/components/VideoComponent.cpp    |  4 ++--
 es-core/src/components/VideoComponent.h      |  5 ++++
 es-core/src/components/VideoVlcComponent.cpp | 13 ++++++----
 5 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/es-app/src/views/SystemView.cpp b/es-app/src/views/SystemView.cpp
index 47e80adb..b71d3b0d 100644
--- a/es-app/src/views/SystemView.cpp
+++ b/es-app/src/views/SystemView.cpp
@@ -241,6 +241,7 @@ void SystemView::loadExtras(SystemData* system)
 		it->backgroundExtras = extras;
 
 	SystemRandomPlaylist::resetCache();
+	showColumnVideos();
 }
 
 // Tabs: while the idle pause holds the home (its videos ended their loop, its slides stopped), the extras of
@@ -1382,9 +1383,33 @@ void SystemView::showColumnLevel(int level)
 	if (grid != nullptr)
 		grid->setCursorShown(level == 2);
 
+	showColumnVideos();
 	updateExtraTextBinding();
 }
 
+void SystemView::showColumnVideos()
+{
+	bool inView = !hasColumns() || mColumnLevel == 2;
+
+	std::function<void(GuiComponent*)> mark = [&mark, inView](GuiComponent* component)
+	{
+		VideoComponent* video = dynamic_cast<VideoComponent*>(component);
+		if (video != nullptr)
+			video->setInView(inView);
+
+		for (unsigned int i = 0; i < component->getChildCount(); i++)
+			mark(component->getChild(i));
+	};
+
+	for (auto& entry : mEntries)
+		for (auto extra : entry.backgroundExtras)
+			mark(extra);
+
+	for (auto& parked : mParkedExtras)
+		for (auto extra : parked.second)
+			mark(extra);
+}
+
 std::vector<HelpPrompt> SystemView::getHelpPrompts()
 {
 	std::vector<HelpPrompt> prompts = mCarousel.getHelpPrompts();
