From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:17:59 +0000
Subject: [PATCH] Copy file cache entries out under the cache's lock

- FileCache::get gave a pointer into the cache after leaving its lock;
  another thread adding an entry could move it meanwhile. It now copies
  the entry under the lock.
- Views and loaders may keep a cache activator at the same time: its count
  and the cache's on flag are atomic.
---
 es-core/src/utils/FileSystemUtil.cpp | 63 +++++++++++++++-------------
 es-core/src/utils/FileSystemUtil.h   |  3 --
 2 files changed, 33 insertions(+), 33 deletions(-)

diff --git a/es-core/src/utils/FileSystemUtil.cpp b/es-core/src/utils/FileSystemUtil.cpp
index 8de6a10c..32c072a6 100644
--- a/es-core/src/utils/FileSystemUtil.cpp
+++ b/es-core/src/utils/FileSystemUtil.cpp
@@ -9,6 +9,7 @@
 #include <sys/stat.h>
 #include <string.h>
 #include <algorithm>
+#include <atomic>
 #include <set>
 
 #if defined(_WIN32)
@@ -142,10 +143,11 @@ namespace Utils
 				mFileCacheMutex.unlock();
 			}
 
-			static FileCache* get(const std::string& key)
+			// A copy: another thread may add to the cache (and move its entries) once the lock is left
+			static bool get(const std::string& key, FileCache& out)
 			{
 				if (!mEnabled)
-					return nullptr;
+					return false;
 
 				std::unique_lock<std::mutex> lock(mFileCacheMutex);
 
@@ -153,17 +155,21 @@ namespace Utils
 				{
 					auto it = mFileCache.find(key);
 					if (it != mFileCache.cend())
-						return &it->second;
+					{
+						out = it->second;
+						return true;
+					}
 
 					it = mFileCache.find(Utils::FileSystem::getParent(key) + "/*");
 					if (it != mFileCache.cend())
 					{
-						mFileCache[key] = FileCache(false, false);
-						return &mFileCache[key];
+						out = FileCache(false, false);
+						mFileCache[key] = out;
+						return true;
 					}
 				}
 
-				return nullptr;
+				return false;
 			}
 
 			static void resetCache()
@@ -179,33 +185,30 @@ namespace Utils
 		private:
 			static std::unordered_map<std::string, FileCache> mFileCache;
 			static std::mutex mFileCacheMutex;
-			static bool mEnabled;
+			static std::atomic<bool> mEnabled;
 		};
 
 		std::unordered_map<std::string, FileCache> FileCache::mFileCache;
 		std::mutex FileCache::mFileCacheMutex;
-		bool FileCache::mEnabled = false;
+		std::atomic<bool> FileCache::mEnabled(false);
 
 	// FileSystemCacheActivator
 
-		int FileSystemCacheActivator::mReferenceCount = 0;
+		// Activators may live on several threads at once (a view's and a loader's)
+		static std::atomic<int> activatorCount(0);
 
 		FileSystemCacheActivator::FileSystemCacheActivator()
 		{
-			if (mReferenceCount == 0)
+			if (activatorCount++ == 0)
 			{
 				FileCache::setEnabled(true);
 				FileCache::resetCache();
 			}
-
-			mReferenceCount++;
 		}
 
 		FileSystemCacheActivator::~FileSystemCacheActivator()
 		{
-			mReferenceCount--;
-
-			if (mReferenceCount <= 0)
+			if (--activatorCount <= 0)
 			{
 				FileCache::setEnabled(false);
 				FileCache::resetCache();
@@ -965,9 +968,9 @@ namespace Utils
 			if (_path.empty())
 				return false;
 
-			auto it = FileCache::get(_path);
-			if (it != nullptr)
-				return it->exists;
+			FileCache cached;
+			if (FileCache::get(_path, cached))
+				return cached.exists;
 
 #ifdef WIN32			
 			if (!FileCache::isEnabled())
@@ -1004,9 +1007,9 @@ namespace Utils
 
 		bool isRegularFile(const std::string& _path)
 		{
-			auto it = FileCache::get(_path);
-			if (it != nullptr)
-				return it->exists && !it->directory && !it->isSymLink;
+			FileCache cached;
+			if (FileCache::get(_path, cached))
+				return cached.exists && !cached.directory && !cached.isSymLink;
 
 			std::string path = getGenericPath(_path);
 			struct stat64 info;
@@ -1022,9 +1025,9 @@ namespace Utils
 
 		bool isDirectory(const std::string& _path)
 		{
-			auto it = FileCache::get(_path);
-			if (it != nullptr)
-				return it->exists && it->directory;
+			FileCache cached;
+			if (FileCache::get(_path, cached))
+				return cached.exists && cached.directory;
 
 #ifdef WIN32
 			// check for symlink attribute
@@ -1053,9 +1056,9 @@ namespace Utils
 		bool isSymlink(const std::string& _path)
 		{
 		
-			auto it = FileCache::get(_path);
-			if (it != nullptr)
-				return it->exists && it->isSymLink;
+			FileCache cached;
+			if (FileCache::get(_path, cached))
+				return cached.exists && cached.isSymLink;
 				
 			std::string path = getGenericPath(_path);
 
@@ -1083,9 +1086,9 @@ namespace Utils
 
 		bool isHidden(const std::string& _path)
 		{
-			auto it = FileCache::get(_path);
-			if (it != nullptr)
-				return it->exists && it->hidden;
+			FileCache cached;
+			if (FileCache::get(_path, cached))
+				return cached.exists && cached.hidden;
 
 			std::string path = getGenericPath(_path);
 
diff --git a/es-core/src/utils/FileSystemUtil.h b/es-core/src/utils/FileSystemUtil.h
index 7ef91dcc..00ae1384 100644
--- a/es-core/src/utils/FileSystemUtil.h
+++ b/es-core/src/utils/FileSystemUtil.h
@@ -95,9 +95,6 @@ namespace Utils
 		public:
 			FileSystemCacheActivator();
 			~FileSystemCacheActivator();
-
-		private:
-			static int mReferenceCount;
 		};
 
 	} // FileSystem::
