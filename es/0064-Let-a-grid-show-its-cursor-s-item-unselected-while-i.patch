-				mEntries[mCursor].data.tile->setSelected(true, true, oldPos == Vector3f::Zero() ? nullptr : &oldPos, true);
+				mEntries[mCursor].data.tile->setSelected(mCursorShown, true, oldPos == Vector3f::Zero() ? nullptr : &oldPos, true);
+
+			if (!mCursorShown)
