Date: Thu, 19 Nov 2026 05:41:49 +0000
Subject: [PATCH] Let a grid show its cursor's item unselected while it has no
 focus

- setCursorShown(false): the cursor's item shows as any other item (its
  deactivate storyboards), then plays the item template's "unfocus"
  storyboards, and stays so as the grid is made again or the cursor
  moves, until setCursorShown(true) selects it again; for a view whose
  focus is in another column.
- getColumnCount and getCursorColumn: the grid's columns (rows of a
  horizontal grid) and the cursor's, to tell its edges.
---
 es-core/src/components/GridTileComponent.cpp | 21 ++++++++
 es-core/src/components/GridTileComponent.h   |  3 ++
 es-core/src/components/ImageGridComponent.h  | 55 ++++++++++++++++++--
 3 files changed, 74 insertions(+), 5 deletions(-)

diff --git a/es-core/src/components/GridTileComponent.cpp b/es-core/src/components/GridTileComponent.cpp
index bebe7dda..66e7c51d 100644
--- a/es-core/src/components/GridTileComponent.cpp
+++ b/es-core/src/components/GridTileComponent.cpp
@@ -1142,6 +1142,27 @@ void GridTileComponent::handleStoryBoard(bool activate)
 	}
 }
 
+void GridTileComponent::playStoryboard(const std::string& event)
+{
+	if (!mHasItemTemplate)
+		return;
+
+	for (auto comp : enumerateExtraChildrens())
+	{
+		if (comp->getStoryBoards().find(event) == comp->getStoryBoards().cend())
+			continue;
+
+		if (comp->isStoryBoardRunning())
+			comp->deselectStoryboard(false);
+
+		if (comp->selectStoryboard(event))
+		{
+			comp->startStoryboard();
+			comp->update(0);
+		}
+	}
+}
+
 void GridTileComponent::onShow()
 {
 	GuiComponent::onShow();	
diff --git a/es-core/src/components/GridTileComponent.h b/es-core/src/components/GridTileComponent.h
