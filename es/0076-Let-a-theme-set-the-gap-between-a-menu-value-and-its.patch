+void GuiGamelistOptions::openGamelistFilter()
+{
+	mReloadAll = false;
+	mFiltersChanged = true;
+	GuiGamelistFilter* ggf = new GuiGamelistFilter(mWindow, mSystem);
+	mWindow->pushGui(ggf);
+}
