From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 04:36:09 +0000
Subject: [PATCH] Make X do in a game list what its prompt says

- Where the game's own emulator and core keep no save states, a short X
  now marks the game favourite (as the long press does) instead of
  opening another emulator's save states, which would start the game with
  that emulator. The prompt, the kid mode's X and the save states' own
  check follow the same rule ({game:saveStatesSupported}).
---
 es-app/src/views/gamelist/ISimpleGameListView.cpp | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/es-app/src/views/gamelist/ISimpleGameListView.cpp b/es-app/src/views/gamelist/ISimpleGameListView.cpp
index d2a13afa..ce989dad 100644
--- a/es-app/src/views/gamelist/ISimpleGameListView.cpp
+++ b/es-app/src/views/gamelist/ISimpleGameListView.cpp
@@ -269,8 +269,11 @@ bool ISimpleGameListView::input(InputConfig* config, Input input)
 	{
 		if (Settings::getInstance()->getBool("GameOptionsAtNorth"))
 			showSelectedGameOptions();
-		else
+		else if (cursorHasSaveStatesEnabled())
 			showSelectedGameSaveSnapshots();
+		else if (!UIModeController::getInstance()->isUIModeKid() && getCursor() != nullptr && getCursor()->getType() == GAME &&
+			(mRoot->getSystem()->isGameSystem() || mRoot->getSystem()->isGroupSystem()))
+			CollectionSystemManager::get()->toggleGameInCollection(getCursor(), "Favorites");	// what its prompt says
 
 		return true;
 	}	
@@ -347,13 +350,11 @@ void ISimpleGameListView::showSelectedGameOptions()
 	mWindow->pushGui(new GuiGameOptions(mWindow, cursor));
 }
 
+// The save states of the emulator and core the game runs with ({game:saveStatesSupported}): another emulator's
+// would start the game with that emulator
 bool ISimpleGameListView::cursorHasSaveStatesEnabled()
 {
-	FileData* cursor = getCursor();
-	if (cursor == nullptr || cursor->getType() != GAME)
-		return false;
-
-	return SaveStateRepository::isEnabled(cursor);
+	return SaveStateRepository::isEnabledForGame(getCursor());
 }
 
 void ISimpleGameListView::showSelectedGameSaveSnapshots()
@@ -362,7 +363,7 @@ void ISimpleGameListView::showSelectedGameSaveSnapshots()
 	if (cursor == nullptr || cursor->getType() != GAME)
 		return;
 
-	if (SaveStateRepository::isEnabled(cursor))
+	if (SaveStateRepository::isEnabledForGame(cursor))
 	{
 		Sound::getFromTheme(mTheme, getName(), "menuOpen")->play();
 
