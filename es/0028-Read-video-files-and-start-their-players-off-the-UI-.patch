+void VideoVlcComponent::checkStart()
+{
+	if (mStart == nullptr)
+		return;
+
+	std::unique_lock<std::mutex> lock(mStart->lock);
+	if (!mStart->ready)
+		return;
+
+	mMediaPlayer = mStart->player;
+	lock.unlock();
+	mStart = nullptr;
+}
