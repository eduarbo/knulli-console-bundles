From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 09:17:12 +0000
Subject: [PATCH] Bind a utility's first twelve items

A theme could bind recent1 to recent8 only: a tools column with nine
tools left the last one out. The items kept and their bindings go up
to twelve.
---
 THEMES_BINDINGS.md        |  2 +-
 es-app/src/SystemData.cpp | 10 +++++++---
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/THEMES_BINDINGS.md b/THEMES_BINDINGS.md
index da8f40e0..20b42214 100644
--- a/THEMES_BINDINGS.md
+++ b/THEMES_BINDINGS.md
@@ -54,7 +54,7 @@ continue                    game                   lastPlayed, else the suggeste
 hasLastPlayed               bool                   lastPlayed exists and still resolves to a game
 hasContinue                 bool                   continue resolves and is not on tools, emulators or screenshots (X does nothing there)
 slides                      string                 The captures of the system's card, one path per line: favorites with a screenshot, else the 12 best-rated games with one (THEMES.md, Slides)
-recent1 ... recent8         game                   On tools, emulators and screenshots only: their items, tools and emulators by last run, screenshots newest first (by file date), then the never run by name ({system:recent1:name}, {system:recent1:image})
+recent1 ... recent12        game                   On tools, emulators and screenshots only: their items, tools and emulators by last run, screenshots newest first (by file date), then the never run by name ({system:recent1:name}, {system:recent1:image})
 image                       path
 showManual                  bool
 showSaveStates              bool
diff --git a/es-app/src/SystemData.cpp b/es-app/src/SystemData.cpp
index 6c230981..36c4766f 100644
--- a/es-app/src/SystemData.cpp
+++ b/es-app/src/SystemData.cpp
@@ -2367,6 +2367,9 @@ FileData* SystemData::getSuggestedGame()
 	return findByPath(mSuggestions.current());
 }
 
+// A utility's items the theme can bind: recent1 to recent12
+#define RECENT_ITEMS 12
+
 FileData* SystemData::getRecentItem(size_t index)
 {
 	if (mRootFolder == nullptr || !isUtilitySystem(this))
@@ -2401,7 +2404,7 @@ FileData* SystemData::getRecentItem(size_t index)
 			items.push_back(item);
 		}
 
-		mRecent = HomeSlides::newestFirst(items, 8);
+		mRecent = HomeSlides::newestFirst(items, RECENT_ITEMS);
 		mRecentCount = files.size();
 	}
 
@@ -2609,9 +2612,10 @@ BindableProperty SystemData::getProperty(const std::string& name)
 	if (name == "slides")
 		return Utils::String::join(getSlides(), "\n");
 
-	if (name.size() == 7 && Utils::String::startsWith(name, "recent") && name[6] >= '1' && name[6] <= '8')
+	if (name.size() > 6 && name.size() <= 8 && Utils::String::startsWith(name, "recent") && name.find_first_not_of("0123456789", 6) == std::string::npos)
 	{
-		FileData* item = getRecentItem(name[6] - '1');
+		int number = Utils::String::toInteger(name.substr(6));
+		FileData* item = number >= 1 && number <= RECENT_ITEMS ? getRecentItem(number - 1) : nullptr;
 		return item != nullptr ? BindableProperty((IBindable*)item) : BindableProperty::Null;
 	}
 
