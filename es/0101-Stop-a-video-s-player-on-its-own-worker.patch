From: Eduardo Ruiz <335073+eduarbo@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:34:53 +0000
Subject: [PATCH] Stop a video's player on its own worker

The players' worker stopped the last video before it started the next:
VLC's stop waits for its threads, and the next card's video waited
behind it. Stops now have a worker of their own, so a start goes on
while the previous player stops; waitForPlayers waits for both before a
game runs.
---
 es-core/src/components/VideoVlcComponent.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/es-core/src/components/VideoVlcComponent.cpp b/es-core/src/components/VideoVlcComponent.cpp
index 3e228bcd..47ab29a3 100644
--- a/es-core/src/components/VideoVlcComponent.cpp
+++ b/es-core/src/components/VideoVlcComponent.cpp
@@ -123,6 +123,14 @@ namespace
 			return worker;
 		}
 
+		// The players' stops, on their own: VLC's stop waits for its threads (a quarter of a second on the
+		// console), and the next card's video need not wait behind it
+		static PlayerWorker* stops()
+		{
+			static PlayerWorker* worker = new PlayerWorker();
+			return worker;
+		}
+
 		// false when the worker already has max tasks waiting (one stuck): the task is not taken
 		bool post(const std::function<void()>& task, size_t max = 0)
 		{
@@ -205,7 +213,7 @@ namespace
 
 	void stopOnWorker(libvlc_media_player_t* player, std::shared_ptr<VideoContext> context)
 	{
-		PlayerWorker::players()->post([player, context]
+		PlayerWorker::stops()->post([player, context]
 		{
 			libvlc_media_player_stop(player);
 			libvlc_media_player_release(player);
@@ -985,6 +993,7 @@ bool VideoVlcComponent::waitForPlayers(int ms)
 {
 	int start = SDL_GetTicks();
 	bool done = PlayerWorker::players()->drain(ms);
+	done = PlayerWorker::stops()->drain(std::max(1, ms - (int)(SDL_GetTicks() - start))) && done;
 	if (done)
 		LOG(LogDebug) << "VideoVlcComponent: players stopped in " << (SDL_GetTicks() - start) << " ms";
 	else
