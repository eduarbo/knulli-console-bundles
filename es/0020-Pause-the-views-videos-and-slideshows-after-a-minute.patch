 es-core/src/Settings.cpp                      |  3 +++
 es-core/src/Window.cpp                        | 12 +++++++++++-
 es-core/src/Window.h                          |  8 ++++++++
 es-core/src/components/SlideLayout.h          |  8 ++++++--
 es-core/src/components/SlideshowComponent.cpp |  4 +++-
