 es-app/src/guis/GuiSaveState.cpp | 32 ++++++++++++++++++++++++++------
 es-core/src/ThemeData.cpp        | 15 +++++++++++++++
 es-core/src/ThemeData.h          |  9 +++++++++
 4 files changed, 67 insertions(+), 7 deletions(-)

