# Pipeline configuration (sourced by bash, read by the Python tools). No secrets here: the
# signing key is the BUNDLE_SIGNING_KEY_B64 secret of the bundle-signing environment.

# Where the pipeline, keys, releases and schedule live (public, not a fork; default branch
# main). Both forks keep Actions off and are only read over git.
BUNDLES_REPO=eduarbo/knulli-console-bundles
BUNDLES_GIT=https://github.com/eduarbo/knulli-console-bundles.git

# Upstream releases and the board image
UPSTREAM_REPO=knulli-cfw/knulli-linux
ASSET_REGEX='^knulli-h700-rg35xx-h-[a-z0-9]+-[0-9]{8}\.img\.gz$'
DEVICE_MODEL='Anbernic RG35XX-H'
# Knulli's own update check (knulli-config canupdate): <url>/<board>/<type>/last/knulli.version
UPDATE_URL=https://updates.knulli.org
UPDATE_BOARD=rg35xx-h
UPDATE_TYPES="stable"

# Owner forks and the fix series (base..ref) carried onto every new release.
# Per tag, in this order: a branch knulli-<tag>-fixes in the fork (owner's resolution), the
# reviewed resolution patches of branch claude/resolution-<tag> of BUNDLES_GIT (data only),
# else the series replayed from the newest tag series/<tag> of BUNDLES_GIT (the resolved
# series of the last complete bundle) or, without one, from the base below.
KNULLI_FORK=https://github.com/eduarbo/knulli-linux.git
KNULLI_UPSTREAM=https://github.com/knulli-cfw/knulli-linux.git
KNULLI_SERIES_BASE=20260511
KNULLI_SERIES_REF=scarab-20260511-fixes
ES_FORK=https://github.com/eduarbo/batocera-emulationstation.git
ES_UPSTREAM=https://github.com/knulli-cfw/batocera-emulationstation.git
ES_SERIES_BASE=4041b56a714265de81de8165b34fbd10f313a891
ES_SERIES_REF=scarab-20260511-fixes
# The fork commits each bundle unit derives from, by path (<group>:<path>,<path>...). Only these
# feed the bundle; the rest of the series (fixes whose device units do not depend on the
# firmware: 02's SDL patch, 04, 05) is replayed for the report only.
KNULLI_GROUPS="01:board/fsoverlay/usr/bin/knulli-suspend 03:board/fsoverlay/usr/bin/knulli-aggressive-saver,board/fsoverlay/etc/idlewatcher,board/fsoverlay/usr/share/emulationstation/scripts 10:board/patches/connman"
# Groups the conflict routine may never resolve (the ConnMan patch stays the reviewed one)
NO_RESOLUTION_GROUPS="10"
# A conflict (or a gate rejection) in a group the bundle needs, or in the ES series:
#   stop     no bundle; the run fails with the report
#   isolate  only the units of that group are left out (reported, run marked failed); the
#            other units are built and published
ON_CONFLICT=isolate
# Where knulli-linux pins the ES commit it ships
ES_PIN_FILE=package/emulationstation/knulli-emulationstation/knulli-emulationstation.mk
ES_PIN_VAR=KNULLI_EMULATIONSTATION_VERSION
# The ConnMan fix inside the knulli-linux series, and where Buildroot keeps the tarball hash
CONNMAN_PATCH=board/patches/connman/001-gsupplicant-enable-optional-pmf-via-global-pmf-property.patch
CONNMAN_HASH_FILE=package/connman/connman.hash

# Build containers, pinned by digest (debian:bookworm-slim, the image units 07 and 10 used),
# with apt pinned to one snapshot.debian.org date (empty: the live mirror)
DEBIAN_IMAGE=debian@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
DEBIAN_SNAPSHOT=20261116T000000Z
# Exit status the build and test steps use for infrastructure failures (apt, network,
# docker): the run fails instead of leaving a unit out
INFRA_EXIT=90

# Stock files the version-tied units pin or depend on (paths inside the rootfs)
STOCK_PATHS="usr/share/knulli/knulli.version usr/bin/emulationstation usr/sbin/connmand usr/bin/knulli-suspend etc/idlewatcher/idle.d/01idle-hooks etc/idlewatcher/active.d/01active-hooks usr/bin/knulli-aggressive-saver etc/init.d/S31emulationstation usr/bin/emulationstation-standalone usr/share/advanced_drastic/drastic usr/share/advanced_drastic/libs/libSDL2-2.0.so.0 usr/share/advanced_drastic/launch.sh"
# GPT partition with the kernel (and its ION/CMA driver); its sha256 is pinned for 02 and 17
KERNEL_PARTITION=boot

# Units carried into every bundle, in install order. Everything is downloaded before the
# first install, so 10 (Wi-Fi) goes first: after an update with a stock ConnMan that cannot
# join the network, it is the fix that brings the network back. 02 before 17 (17 takes over
# 02's guard), 03 before 07 (the saver hold keeps ES awake while 07 restarts it).
# 17, 18 and 20 join once they are installed and verified on the console (their recipes in
# repin.py and test_units.py are ready): 10 01 02 17 03 18 20 07.
UNITS="10-wifi-pmf-8821cs 01-suspend-auto-poweroff 02-ds-cma-after-suspend 03-powersaver-es-api 07-es-api-events"
